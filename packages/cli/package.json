{
  "name": "pulsecommerce-cli",
  "version": "0.1.0",
  "description": "Command-line client for the PulseCommerce API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulsecommerce/pulsecommerce.git",
    "directory": "packages/cli"
  },
  "keywords": ["pulsecommerce", "woocommerce", "whatsapp", "cli"],
  "type": "module",
  "bin": {
    "pulse": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --shims && chmod +x dist/index.js",
    "dev": "tsup src/index.ts --format esm --watch --onSuccess \"node dist/index.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "pulsecommerce-sdk": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
