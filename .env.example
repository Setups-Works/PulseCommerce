# Public HTTPS address this app is reachable at. WooCommerce will only deliver
# credentials to an HTTPS callback, so the authorize flow needs this.
# Locally: run `npm run dev:https` and set https://localhost:3000
APP_URL=https://localhost:3000

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Set alongside AUTH_SECRET to require a password before the dashboard opens.
# Leave both unset to run without a login.
APP_PASSWORD=

# How long a fetched snapshot stays warm on disk before being re-pulled.
SNAPSHOT_CACHE_MINUTES=60
