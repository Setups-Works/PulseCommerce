# Public HTTPS address this app is reachable at. WooCommerce will only deliver
# credentials to an HTTPS callback, so the authorize flow needs this.
# Locally: run `npm run dev:https` and set https://localhost:3000
APP_URL=https://localhost:3000

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Set alongside AUTH_SECRET to require a password before the dashboard opens.
# Leave both unset to run without a login.
APP_PASSWORD=

# How long a fetched snapshot stays warm on disk before being re-pulled.
SNAPSHOT_CACHE_MINUTES=60

# ── Supabase (optional, recommended for hosted deployments) ─────────────────
# Used as durable storage for the WooCommerce credentials and the cached order
# snapshot. Without it a serverless deployment re-pulls the whole order history
# on every cold start, because the filesystem is read-only and each instance
# starts empty.
#
# Both are required together; the anon key is not accepted. The kv_store table
# has row level security on with no policies, so only the service-role key can
# reach it — and it holds the consumer secret and a copy of the order history,
# so it must never be exposed to a browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
