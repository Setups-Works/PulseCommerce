# Copy to .env.local and fill in. Everything here is optional except APP_URL —
# the app starts without any of it and tells you what is missing.
#
# A note on Vercel: values set there are sensitive and cannot be read back, so
# this file is the only record of what a deployment needs. `vercel env pull`
# targets the `development` environment and overwrites .env.local wholesale —
# it will not restore anything set on Production or Preview.

# ── App ─────────────────────────────────────────────────────────────────────

# Public HTTPS address this app is reachable at. WooCommerce will only deliver
# credentials to an HTTPS callback, so the authorize flow needs this.
# Locally: run `npm run dev:https` and set https://localhost:3000
APP_URL=https://localhost:3000

# Canonical origin used in sitemaps, OG tags and JSON-LD. Set this in
# production so previews do not advertise themselves as the primary site.
NEXT_PUBLIC_SITE_URL=

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Set alongside AUTH_SECRET to require a password before the dashboard opens.
# Leave both unset to run without a login.
APP_PASSWORD=

# How long a store's snapshot stays memoised in the server process before the
# next request re-reads it from the mirror (Postgres). Real freshness is
# already bounded by the sync schedule (every 10 minutes), so raising this
# only trades a little more staleness for less Supabase read/egress traffic —
# it never makes the dashboard show data older than the last sync.
SNAPSHOT_CACHE_MINUTES=10

# Shared secret for /api/cron/flows, so only the scheduler can trigger a send.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ── WhatsApp gateway ────────────────────────────────────────────────────────
# The self-hosted gateway the app sends through. Set both to configure it from
# the environment; leave both unset to connect one through the settings UI
# instead. When they are set the UI becomes read-only, because the host owns
# the configuration.

WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Country code applied to recipient numbers that arrive without one, digits
# only — e.g. 91 for India.
WHATSAPP_DIAL_CODE=

# Which gateway session to send from. Omit when the gateway has exactly one:
# the app adopts it automatically and only asks if there is a choice to make.
WHATSAPP_SESSION_ID=

# Pause between sends, in milliseconds. Raise it if the gateway rate-limits.
WHATSAPP_SEND_DELAY_MS=

# ── Billing (Razorpay) ──────────────────────────────────────────────────────
# UPI Autopay subscriptions for the Go and Plus plans. Without these, the
# Billing card in Settings shows current usage but subscribing is unavailable.
# Razorpay dashboard -> Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay dashboard -> Settings -> Webhooks -> the secret you set when
# registering https://<APP_URL>/api/billing/webhook. Verifies that a webhook
# call actually came from Razorpay before it can change anyone's plan.
RAZORPAY_WEBHOOK_SECRET=

# Plan ids from Razorpay dashboard -> Subscriptions -> Plans. Created once,
# there, in rupees — not created by this app, which only ever references them.
RAZORPAY_PLAN_ID_GO=
RAZORPAY_PLAN_ID_PLUS=

# Same as RAZORPAY_KEY_ID, duplicated with the NEXT_PUBLIC_ prefix because
# Razorpay's Checkout.js widget runs in the browser and needs it there. Safe
# to expose: it identifies your account, it cannot authorize a charge.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── AI assistant ────────────────────────────────────────────────────────────
# Groq console -> API Keys. Without it the assistant is unavailable; the rest
# of the app is unaffected.
GROQ_API_KEY=

# Optional overrides. Defaults: openai/gpt-oss-120b, then
# llama-3.3-70b-versatile if the primary is unavailable.
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# ── Durable storage ─────────────────────────────────────────────────────────
# Where the WooCommerce credentials and the cached order snapshot live.
#
# Serverless platforms have a read-only filesystem and start every instance
# empty, so without one of these a hosted deployment re-pulls the entire order
# history on every cold start — slow, and enough sustained traffic that a
# store's security layer starts refusing requests.
#
# Supabase is tried first, then Redis, then the local filesystem.

# Supabase. Both are required together. The anon key is NOT accepted, and
# neither is a key issued for a different project — kv_store has row level
# security on with no policies, so only the service-role key reaches it, and it
# holds the consumer secret and a copy of the order history. It must never be
# exposed to a browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used by `supabase db push` to apply migrations. Not read by the app.
SUPABASE_DB_PASSWORD=

# Any Upstash-compatible Redis, including Vercel KV. Used when Supabase is not
# configured. UPSTASH_REDIS_REST_URL / _TOKEN are accepted as aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=
